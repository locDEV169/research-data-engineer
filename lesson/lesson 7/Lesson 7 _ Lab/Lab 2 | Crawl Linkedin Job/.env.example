# Cookie LinkedIn cho Lab Lesson 7.
#
# Cách dùng:
#     cp .env.example .env
#     chmod 600 .env        # cookie = mật khẩu, chỉ mình mình đọc được
#     # rồi mở .env, thay 2 giá trị bên dưới bằng cookie thật
#     make check            # xác nhận đã điền đúng
#
# Lấy cookie: Chrome đang đăng nhập linkedin.com > F12 > Application > Storage >
#             Cookies > https://www.linkedin.com
# Hai cookie phải lấy CÙNG một phiên đăng nhập, nếu không sẽ bị HTTP 401/403.
#
# Giữ nguyên chữ `export` ở đầu dòng: nhờ nó, file này vừa `source .env` được
# trong bash, vừa được load_dotenv() của Python đọc hiểu — một file, hai cách dùng.
# Dùng nháy ĐƠN '...' để bash không diễn giải ký tự đặc biệt trong cookie.

# Cột Value của cookie li_at (chuỗi dài ~150 ký tự)
export LI_AT='AQEDAS8Xy...'

# Cột Value của cookie JSESSIONID — BỎ dấu nháy kép của LinkedIn,
# chỉ giữ phần ajax:... bên trong nháy đơn của bash.
export LI_JSESSIONID='ajax:1234567890123456789'
